.table-top, .table-seats, .table-bottom, .hud-row { flex-direction: row; align-items: center; }
.table-top { justify-content: space-between; margin: 13px 22px 0 22px; }
.street-banner, .pot-banner {
    -unity-background-scale-mode: scale-to-fit;
    -unity-text-align: middle-center; -unity-font-style: bold;
    width: 205px; height: 68px; font-size: 21px;
}
.street-banner { background-image: url("../턴.png"); color: #332013; padding-left: 12px; }
.pot-banner { background-image: url("../메인.png"); }
.table-seats { align-self: center; margin-top: 4px; }
.table-seat {
    background-color: rgba(30, 22, 16, 0.9); border-radius: 6px; border-width: 1px;
    border-color: #906647; margin: 0 4px; padding: 4px 10px; font-size: 14px;
}
.table-seat.current { border-color: #ffbe55; color: #ffcf78; }
.table-bottom { position: absolute; bottom: 12px; left: 16px; right: 16px; align-items: flex-end; justify-content: flex-end; }
.hud-title { -unity-font-style: bold; margin: 0 0 4px 0; }
.table-controls { align-items: flex-end; }
.turn-status { background-color: rgba(28, 20, 15, 0.91); padding: 6px 11px; border-radius: 6px; }
.move {
    width: 76px; height: 89px; padding: 58px 0 0 0;
    -unity-background-scale-mode: scale-to-fit; -unity-text-align: lower-center;
    background-color: transparent; border-width: 0; color: #fff0cc; -unity-font-style: bold;
}
.move:hover { scale: 1.08; }
.move:disabled { opacity: 0.35; }
.fold { background-image: url("../폴드.png"); }
.call { background-image: url("../체크.png"); }
.raise { background-image: url("../레이즈.png"); }
.sizing { background-color: #2e2119; width: 295px; padding: 11px; margin: 4px 0; border-radius: 8px; }
.sizing SliderInt { height: 29px; padding: 0 8px; }
.sizing .unity-base-slider__tracker {
    height: 16px; background-image: url("../레이즈_bar.png"); -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent; border-width: 0;
}
.sizing .unity-base-slider__dragger {
    width: 26px; height: 18px; background-image: url("../슬라이더.png");
    -unity-background-scale-mode: stretch-to-fill; background-color: transparent; border-width: 0;
}
.presets { justify-content: space-between; }
.preset {
    width: 84px; height: 37px; padding-left: 19px; background-color: transparent; border-width: 0;
    color: #fff0cc; -unity-font-style: bold; -unity-background-scale-mode: scale-to-fit;
}
.preset.min { background-image: url("../최소.png"); }
.preset.half { background-image: url("../하프.png"); }
.preset.all-in { background-image: url("../올인.png"); }
.table-notice {
    position: absolute; top: 25%; align-self: center; max-width: 75%;
    padding: 10px 20px; background-color: rgba(30, 22, 16, 0.92);
    border-width: 1px; border-color: #d69d57; border-radius: 8px;
    color: #ffdfaa; -unity-font-style: bold; white-space: normal;
}
